# =============================================================================
# OpenClaw gateway container — DemoBot agentic-risk demo surface
# =============================================================================
# The gateway runs in podman rather than on the host: Cisco Secure Endpoint
# quarantines the npm-installed OpenClaw entrypoint on this machine (observed
# 2026-07-27: openclaw.mjs deleted minutes after install, twice). Inside the
# podman VM the files are out of the host scanner's reach, and the container
# also gives the demo its sandboxed-agent posture for free.
#
# The whole openclaw/ directory — this file and the plugin it bakes in — is
# tracked in git but sparse-checkout-excluded from this Mac's working tree, so
# there is nothing on disk for AMP to delete. Read or change it with
# `scripts/openclaw-edit.sh`; do NOT check it out to edit it.
#
# Build:  git archive HEAD:openclaw | podman build -t demobot-openclaw -f Containerfile -
#         (run-openclaw.sh does this automatically when HEAD:openclaw changes;
#          the git stream IS the build context, so nothing is written to disk)
# Run:    ./run-openclaw.sh   (mounts config/state/workspace, publishes the
#                              gateway port, wires host.containers.internal)
# =============================================================================

FROM docker.io/library/node:22-bookworm-slim

# Pin the exact OpenClaw version. The project moves fast and the plugin API is
# compat-gated; bump deliberately, never implicitly. Keep in sync with the
# preflight check in run-openclaw.sh.
ARG OPENCLAW_VERSION=2026.7.1-2

# git: ClawHub/skill operations shell out to it. procps: `ps` for the gateway's
# process diagnostics. curl: the container healthcheck below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    procps \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g "openclaw@${OPENCLAW_VERSION}" && npm cache clean --force

# The demobot-toolguard plugin (the before_tool_call governance seat) is baked
# in rather than bind-mounted: a mount would need a copy staged somewhere under
# $HOME on the host, which is exactly the disk AMP watches. Copied as root, so
# it lands read-only for the `node` user — same posture as the old :ro mount.
# run-openclaw.sh rebuilds whenever the openclaw/ tree hash changes, so a
# committed plugin edit still takes effect on the next start.
COPY plugins/demobot-toolguard/ /opt/demobot-plugins/demobot-toolguard/

# Non-root, mirroring the app Containerfile. The node base image ships a
# `node` user (uid 1000); reuse it rather than minting another.
USER node

# Config, state, and the agent workspace are bind mounts supplied by
# run-openclaw.sh:
#   /home/node/.openclaw            gateway config + state (persisted)
#   /home/node/.openclaw/workspace  the decoy workspace (~/DemoBotDecoy)
# The plugin at /opt/demobot-plugins is baked in above, not mounted.
ENV OPENCLAW_STATE_DIR=/home/node/.openclaw

# Gateway control plane. Bind to all interfaces inside the container so the
# published port is reachable from the host browser.
EXPOSE 18789

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:18789/ >/dev/null || exit 1

CMD ["openclaw", "gateway", "--bind", "0.0.0.0", "--port", "18789"]
