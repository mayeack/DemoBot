# =============================================================================
# DemoBot v4 Configuration
# =============================================================================
# This application supports multiple AI providers:
# - Local development: Uses Anthropic API or OpenAI-compatible APIs directly
# - AWS production: Uses Amazon Bedrock
# =============================================================================

# -----------------------------------------------------------------------------
# AI Provider Selection
# -----------------------------------------------------------------------------
# Options: "anthropic", "bedrock", "openai", "nvidia" (NVIDIA NIM),
# or "ollama" (local uncensored model)
AI_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic API Configuration (used when AI_PROVIDER=anthropic)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# -----------------------------------------------------------------------------
# AWS Bedrock Configuration (used when AI_PROVIDER=bedrock)
# -----------------------------------------------------------------------------
# Note: When running on AWS ECS, credentials come from IAM role (no keys needed)
# For local testing with Bedrock, configure AWS CLI: aws configure
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# -----------------------------------------------------------------------------
# OpenAI-Compatible API Configuration (used when AI_PROVIDER=openai)
# -----------------------------------------------------------------------------
# Works with OpenAI, DeepSeek, Together AI, Ollama, and other compatible APIs.
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek example:
# OPENAI_MODEL=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com

# -----------------------------------------------------------------------------
# NVIDIA NIM Configuration (used when AI_PROVIDER=nvidia) — LOCAL inference only
# -----------------------------------------------------------------------------
# provider=nvidia is a NIM (NVIDIA Inference Microservice) container running on
# THIS host, serving an OpenAI-compatible API on a loopback port. It is never the
# hosted API catalog (build.nvidia.com): the app rejects a non-loopback URL. A
# remote GPU box runs its own DemoBot replica against its own NIM.
#
# Start one on a GPU host (needs Docker + the NVIDIA Container Toolkit and an
# NGC key for the image pull — FLEET_NIM=1 ./deploy/ec2/fleet.sh deploy, i.e.
# deploy/ec2/ec2-bootstrap.sh --with-nim, does all of it):
#   docker login nvcr.io -u '$oauthtoken' -p "$NGC_API_KEY"
#   docker run -d --gpus all --shm-size=16GB -e NGC_API_KEY -p 8000:8000 \
#     -v /opt/nim-cache:/opt/nim/.cache nvcr.io/nim/nvidia/nvidia-nemotron-nano-9b-v2:latest
#   curl http://localhost:8000/v1/health/ready      # 200 = serving
# GPU sizing: nvidia-nemotron-nano-9b-v2 fits one A10G/L4 24 GB (g5.xlarge);
# nemotron-3-super-120b-a12b needs 8x H100-80GB (p5.48xlarge-class).
NVIDIA_BASE_URL=http://localhost:8000/v1
# The model id the local NIM serves (one model per NIM; switching = a different image).
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
# Only if the NIM was started behind an API-key gate. Not an nvapi- cloud key.
# NVIDIA_API_KEY=
# Nemotron 3 reasoning ("thinking") mode — defaults OFF so the JSON answer
# contract is not wrapped in a reasoning trace. True = enable_thinking.
# NVIDIA_REASONING=False
# NIM images offered in the model dropdown before a NIM is up, with GPU needs:
# "<model id>|<GPU label>|<min VRAM MB per GPU, as reported>|<GPU count>".
# NVIDIA_FEATURED_MODELS=nvidia/nvidia-nemotron-nano-9b-v2|1x A10G / L4 24 GB|22000|1,nvidia/nemotron-3-super-120b-a12b|8x H100-80GB|76000|8
# Image-pull credential for nvcr.io (used by the bootstrap / systemd unit, not the app).
# NGC_API_KEY=

# -----------------------------------------------------------------------------
# Ollama Configuration (used when AI_PROVIDER=ollama)
# -----------------------------------------------------------------------------
# Local, UNCENSORED open-source model served by a local Ollama daemon. Workshop
# demo: an unaligned model that produces unsafe/toxic/PII output on purpose so
# the external guardrails (Cisco AI Defense, Splunk, Galileo) demonstrably catch
# it. Requires the Ollama runtime running with the model pulled:
#     ollama serve            # leave running; listens on 127.0.0.1:11434
#     ollama pull mistral-nemo:12b # ~5 GB
# Then set AI_PROVIDER=ollama above.
#
# PERFORMANCE: to keep BOTH the clean and poisoned ~5GB models resident (so
# switching models in the Settings UI / Galileo runner is instant) and avoid
# idle-unload reloads, either:
#   (a) temporary (this session): OLLAMA_MAX_LOADED_MODELS=2 OLLAMA_KEEP_ALIVE=30m ollama serve
#   (b) durable across reboots (macOS): ./setup-ollama-env.sh  (one-shot LaunchAgent;
#       restart Ollama.app once afterward so it inherits the vars)
# (Those are read by `ollama serve`, not by this app. The app-side OLLAMA_KEEP_ALIVE
# below is the per-call keep_alive ChatOllama sends.)
# AI_PROVIDER=ollama
OLLAMA_MODEL=mistral-nemo:12b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192
# Per-call keep_alive ChatOllama sends so the model stays warm between turns.
OLLAMA_KEEP_ALIVE=30m
# Model the internal coordinator/specialist agents run on (kept CLEAN so a
# poisoned OLLAMA_MODEL only affects the user-facing synthesizer).
OLLAMA_MODEL_INTERNAL=mistral-nemo:12b
# Smaller / more refusal-free alternatives (abliterated = refusal direction
# removed from the weights):
#   OLLAMA_MODEL=huihui_ai/llama3.2-abliterate:3b   # ~2GB, low RAM
#   OLLAMA_MODEL=huihui_ai/llama3.2-abliterate:8b

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME=DemoBot v4
APP_VERSION=4.8.1
ENVIRONMENT=development
DEBUG=True
# Appointment scheduling: fallback IANA zone for slot labels when the browser
# doesn't send its own (the chat sends client_tz). Storage is always UTC.
SCHEDULING_DEFAULT_TIMEZONE=America/New_York

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001

# Label for the box serving this instance, shown in the UI footer so a
# multi-server deployment (Mac vs EC2 replicas) is distinguishable at a glance.
# Empty/unset falls back to the OS hostname.
# SERVER_HOSTNAME=

# Send one throwaway generation at startup so the first real chat turn doesn't
# pay model load time. Costs a few seconds of boot on a local model.
# PREWARM_LLM=False

# Public access gate. When set, every request (except /health) requires this
# value as the HTTP Basic Auth password — one shared secret gates both the web
# UIs and the API. Leave empty/unset to disable (local development).
# Generate one with:  openssl rand -hex 24
# ACCESS_KEY=

# Browser origins allowed to call this API cross-origin, comma-separated. The
# web UIs are served by this same app (same-origin), so they need NO entry here
# and the default empty value is correct for every normal deployment. Set it
# only for an external browser client, and list exact origins:
#   CORS_ORIGINS=https://dashboard.example.com,https://medadvice.yeackbot.com
# Never "*": responses here are credentialed (session cookie / Basic auth), and
# wildcard-plus-credentials makes every site a credential-allowed origin.
# CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Local development: SQLite
DATABASE_URL=sqlite:///./medadvice.db
# AWS production example: PostgreSQL
# DATABASE_URL=postgresql://username:password@rds-endpoint:5432/medadvice

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_TO_CONSOLE=True
LOG_TO_DATABASE=True
LOG_ROTATION_SIZE=10485760
LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Safety Configuration
# -----------------------------------------------------------------------------
# Background rate at which each governance test-content category is requested
# when its UI toggle is OFF (ON = always). Drives the input directive that asks
# the model to produce synthetic PII/PHI, toxic, hallucinated, or
# outside-of-authority content for the guardrail demo.
# NOTE: 0.25 matches the code default (backend/config.py). The template used to
# say 0.05, so anyone assessing how much synthetic PII the demo emits out of the
# box was reading a figure five times too low.
PII_INJECTION_RATE=0.25
TOXIC_INJECTION_RATE=0.25
HALLUCINATION_INJECTION_RATE=0.25
AUTHORITY_INJECTION_RATE=0.25
REQUIRE_DISCLAIMER_ACCEPTANCE=True
MAX_CLARIFYING_QUESTIONS=2

# -----------------------------------------------------------------------------
# Cisco AI Defense - Inspection API (optional prompt policy review)
# -----------------------------------------------------------------------------
# When enabled, prompts can be sent to the AI Defense Chat Inspection API for
# runtime policy review (the per-chat "Cisco AI Defense Policy Review" toggle).
# Docs: https://developer.cisco.com/docs/ai-defense-inspection/
#
# The enabled flag, key, region and endpoint below can also be edited at runtime
# from the Settings page's "Cisco AI Defense" card. A value saved there is stored
# in the local SQLite blob and re-applied over these on the next startup.
#
# Master switch. The UI toggle is ignored unless this is True.
AI_DEFENSE_ENABLED=False
# Inspection API key generated in the AI Defense UI when you create an
# "API" connection (Connect to AI Defense > API connection). Sent in the
# X-Cisco-AI-Defense-API-Key header. Keep this secret; never commit a real key.
AI_DEFENSE_API_KEY=your_ai_defense_inspection_api_key_here
# Regional deployment of your AI Defense tenant: us | eu | ap
AI_DEFENSE_REGION=us
# Optional explicit base URL override (wins over region) for private/hybrid:
# AI_DEFENSE_ENDPOINT=https://us.api.inspect.aidefense.security.cisco.com
# Inspection request timeout (seconds)
AI_DEFENSE_TIMEOUT=10.0
# Behavior when the Inspection API errors/malforms:
#   False = fail closed (block the prompt) - recommended secure default
#   True  = fail open  (allow the prompt through)
AI_DEFENSE_FAIL_OPEN=False
# Comma-separated guardrails enforced explicitly on every Inspection API call
# (sent as config.enabled_rules). Passing rules here applies them directly and
# makes enforcement self-contained/direction-independent instead of relying on
# the SCC-configured policy. Rule names must match the API enum exactly.
# Valid: Code Detection, Harassment, Hate Speech, PCI, PHI, PII,
#        Prompt Injection, Profanity, Sexual Content & Exploitation,
#        Social Division & Polarization, Violence & Public Safety Threats
# Leave empty to fall back to the connection's UI-configured policy (config: {}).
AI_DEFENSE_ENABLED_RULES=PII,PHI,PCI,Harassment,Hate Speech,Profanity,Sexual Content & Exploitation,Violence & Public Safety Threats,Social Division & Polarization,Prompt Injection,Code Detection
# Guardrails enforced on the *response* (model output) direction. Drops the
# prompt-only rules (Prompt Injection, Code Detection) and keeps the content-harm
# set that matters for generated output.
AI_DEFENSE_RESPONSE_ENABLED_RULES=PII,PHI,PCI,Harassment,Hate Speech,Profanity,Sexual Content & Exploitation,Violence & Public Safety Threats
# Custom guardrail name that flags DemoBot exceeding its authority (recommending
# a prescription-only / non-OTC medication, dosage, or procedure). NOT a Cisco
# standard rule: create it as a custom guardrail on the connection's SCC policy
# (response/output direction), then set its EXACT name here. Leave empty unless
# the guardrail exists on the connection — an unknown rule name can fail-closed
# and block every response. (On SCC-policy-bound connections enabled_rules are
# ignored and the console policy enforces it regardless of this value.)
AI_DEFENSE_PRESCRIPTION_GUARDRAIL=

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
SESSION_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
# Agentic Orchestration (LangChain + LangGraph)
# -----------------------------------------------------------------------------
# True  = serve chat turns via the supervisor-routed multi-agent LangGraph
#         workflow (backend/agents). On missing deps / build failure the router
#         transparently falls back to the legacy RecommendationEngine.
# False = always use the legacy engine.
USE_AGENTIC_ENGINE=True
# Name promoted to the OTel GenAI Workflow span (Splunk AI Agent Monitoring
# groups traces by this workflow name). Since blueprints, each architecture
# names its own workflow; this is the fallback.
AGENTIC_WORKFLOW_NAME=demobot_multi_agent
# Which agentic architecture serves chat turns by default (the chat header's
# "Blueprint" dropdown persists a runtime override):
#   demobot_multi_agent        the shipped architecture (intake -> [coordinator ->
#                              specialists] -> synthesizer)
#   nvidia_virtual_assistant   NVIDIA's AI Virtual Assistant blueprint (primary
#                              assistant -> tool-routed sub-assistant with
#                              knowledge retrieval + record lookup -> responder)
# Every guardrail, toggle and governance field is shared by both (CLAUDE.md
# "Blueprint feature parity"; tests/test_blueprint_parity.py).
# ACTIVE_BLUEPRINT=demobot_multi_agent
# NVIDIA blueprint routing: auto (native tool calling when the provider supports
# it, else a JSON tool-call plan) | tools | json
# BLUEPRINT_ROUTING=auto
# LOCAL embedding endpoint for the blueprint's knowledge retrieval (OpenAI-compatible
# /v1/embeddings on this host, e.g. a llama-nemotron-embed-1b-v2 NIM on :8001).
# Empty = keyword retrieval over blueprint_data/<theme>/docs (no model needed).
# BLUEPRINT_EMBED_URL=
# BLUEPRINT_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2

# -----------------------------------------------------------------------------
# Agentic Observability (OpenTelemetry GenAI -> Splunk Observability Cloud)
# -----------------------------------------------------------------------------
# The app exports OTLP to a LOCAL Splunk OTel Collector (./run-collector.sh),
# which forwards to Splunk Observability Cloud. run.sh launches the app under
# `opentelemetry-instrument` whenever OTEL_EXPORTER_OTLP_ENDPOINT is set, enabling
# the LangChain + FastAPI auto-instrumentation (traces + GenAI metrics).
#
# The Settings page's "Splunk Observability Cloud" card edits SPLUNK_REALM,
# O11Y_INGEST, O11Y_API, OTEL_EXPORTER_OTLP_ENDPOINT and
# OTEL_RESOURCE_ATTRIBUTES by rewriting them HERE (their consumers are separate
# processes), so a save needs a collector / app restart to take effect.
#
# Collector credentials (used by run-collector.sh, NOT the app itself):
# SPLUNK_REALM=us1
# O11Y_INGEST=your-splunk-o11y-access-token
# Optional: an O11y *API* token (not the ingest token) for the observability
# regression test's end-to-end metadata check (tests/observability):
# O11Y_API=your-splunk-o11y-api-token
#
OTEL_SERVICE_NAME=demobot-v3
# Keep /health probe spans out of APM (the tunnel and launchd both poll it).
# OTEL_PYTHON_EXCLUDED_URLS=health
# The local collector defines no logs pipeline, so under opentelemetry-instrument
# the app would retry OTLP log export forever against a receiver that drops it.
# OTEL_LOGS_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=DELTA
# Resource attributes stamped on every span/metric. deployment.environment is what
# separates one DemoBot instance from another in O11y — give each box in a
# multi-instance workshop a distinct value, and keep OTEL_SERVICE_NAME identical so
# they stay one service. Editable from the Settings page (app restart to apply).
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=demobot-local
# Span CONTENT capture. Required for O11y's "AI trace data" span LIST view —
# without it spans still reach APM but that view is empty. SPAN_ONLY is the
# current single-variable form; the old CAPTURE_MESSAGE_CONTENT=true +
# ..._MODE=SPAN pair is deprecated and logs a warning.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY
# OTEL_INSTRUMENTATION_GENAI_EMITTERS=span_metric,splunk
# Hand-rolled spans in backend/telemetry/otel.py, separate from the Splunk
# auto-instrumentation. Leave False to rely solely on auto-instrumentation.
OTEL_ENABLED=False

# -----------------------------------------------------------------------------
# Galileo (LLM observability / evals) — optional
# -----------------------------------------------------------------------------
# Traces fan out from the OTel Collector to Galileo, AND completed turns are
# logged via the SDK with governance metadata (backend/galileo_integration.py).
# All a no-op unless GALILEO_API_KEY is set. Create the key + project + log stream
# in your Galileo console, or edit them at runtime from the Settings page's
# "Splunk Agent Observability" sub-card (they apply on the next chat turn).
# For Galileo Cloud (app.galileo.ai) GALILEO_CONSOLE_URL
# is optional; for any other deployment (e.g. a multi-tenant / enterprise cluster)
# set it to the console base URL — the SDK derives the API URL by swapping
# console -> api, and the collector fan-out points at <api host>/otel/traces.
# GALILEO_API_KEY=your-galileo-api-key
# GALILEO_CONSOLE_URL=https://console.multitenant.galileocloud.io
# GALILEO_PROJECT=YeackBot
# GALILEO_LOG_STREAM=default

# -----------------------------------------------------------------------------
# Galileo Agent Control — the "Agent Observability Controls" per-chat toggle
# -----------------------------------------------------------------------------
# When the toggle is on, each generated response is submitted to Galileo's Agent
# Control server as a post-stage `llm` step and evaluated against the Controls in
# the Galileo console; a matching Deny control (e.g. DemoBot-block-hallucinated-
# output, which fails a response scoring below threshold on Correctness) withholds
# the answer. Reuses GALILEO_API_KEY / GALILEO_CONSOLE_URL above — a no-op without
# the key, exactly like the logging path.
#
# Controls only apply to the agent they are attached to. Register the agent and
# attach a control once per tenant:
#   venv/bin/python scripts/demo/register_agent_control.py --attach <control_id>
#
# Master switch. False = the per-chat toggle is ignored and no step is ever sent.
# GALILEO_AGENT_CONTROL_ENABLED=True
# Agent Control server base URL (mirrors the console host).
# GALILEO_AGENT_CONTROL_URL=https://agent-control.multitenant.galileocloud.io
# Registered agent + step identity. >=10 chars, lowercase [a-z0-9:_-].
# GALILEO_AGENT_CONTROL_AGENT_NAME=demobot-agent
# GALILEO_AGENT_CONTROL_STEP_NAME=demobot-llm
# Evaluation timeout (seconds). Server-side Luna scorers are an LLM-judge
# round-trip, so this is looser than the AI Defense inspection timeout.
# GALILEO_AGENT_CONTROL_TIMEOUT=25.0
# Which transport evaluates the controls:
#   auto   (default) prefer the Agent Control server, fall back to client-side
#   server server only — no verdict when a runtime token cannot be minted
#   client always evaluate in-process
# Client-side execution is the `execution: "sdk"` equivalent: DemoBot reads the
# agent's control definitions from the management API and runs their Luna
# conditions itself via the console API's /scorers/invoke. It exists because an
# org without a runtime-token grant cannot use the server path at all — the
# exchange returns 502 and /evaluation then rejects the console token with
# `401 Token is missing the "iat" claim`.
# GALILEO_AGENT_CONTROL_EXECUTION=auto
# How long fetched control definitions are reused before refetching (seconds).
# A refresh failure keeps serving the last-known set rather than failing turns.
# GALILEO_AGENT_CONTROL_REFRESH_SECONDS=300.0
# Behavior when the server errors / is unreachable / cannot mint a runtime token.
# True = fail open (release the response, log the error) — the default, because
# this layer sits after the internal policy engine and Cisco AI Defense.
# False = fail closed (withhold), matching AI Defense's posture. Only set False
# once runtime enforcement is verified working, or every response is withheld.
# GALILEO_AGENT_CONTROL_FAIL_OPEN=True

# -----------------------------------------------------------------------------
# NVIDIA NeMo Guardrails — the "NeMo Guardrails" per-chat toggle
# -----------------------------------------------------------------------------
# In-process nemoguardrails (guardrails/nemo/config.yml + prompts.yml). Input
# rails run on the prompt after Cisco AI Defense; output rails run on the answer
# after Agent Control and BEFORE AI Defense's response inspection. The judge for
# the self-check rails is the ACTIVE chat model (no cloud call); NemoGuard
# content safety is an optional second local NIM. Editable at runtime from the
# Settings page's "NVIDIA NeMo Guardrails" card (applies on the next turn).
#
# Master switch. The UI toggle is ignored unless this is True.
NEMO_GUARDRAILS_ENABLED=False
# Rails to activate: self_check_input, self_check_output (NeMo's LLM self-checks)
# and overreach (DemoBot's prescriptive-overreach output rail).
# NEMO_GUARDRAILS_RAILS=self_check_input,self_check_output,overreach
# Optional NemoGuard content-safety NIM on THIS host (loopback only), e.g.
# http://localhost:8001/v1 — an 8B guard NIM does not fit beside the 9B
# inference NIM on one A10G, so this is off by default.
# NEMO_GUARDRAILS_CONTENT_SAFETY_URL=
# NEMO_GUARDRAILS_CONTENT_SAFETY_MODEL=nvidia/llama-3.1-nemoguard-8b-content-safety
# Behavior when the rails cannot produce a verdict. True = fail open (release
# the turn, log) — the default; False withholds the turn.
# NEMO_GUARDRAILS_FAIL_OPEN=True
# Output cap for the judge's Yes/No answer.
# NEMO_GUARDRAILS_JUDGE_MAX_TOKENS=64

# -----------------------------------------------------------------------------
# Agentic tool guard (OpenClaw surface -> /api/toolguard/inspect) — optional
# -----------------------------------------------------------------------------
# The OpenClaw gateway's demobot-toolguard plugin submits every proposed agent
# tool call here before it executes. Evaluation ALWAYS runs (deterministic policy
# + optional Cisco AI Defense) so telemetry stays honest either way; the flag
# below only controls whether a "block" verdict actually denies the call.
# False = observe-only, i.e. the unguarded control run that makes the demo's
# before/after contrast. NOTE: with True, a dead app on :8001 denies EVERY agent
# tool call (fail-closed) — that looks like a broken agent, not a broken app.
# TOOL_GUARD_ENABLED=False

# CONTAINER-side workspace roots the agent's file paths must stay inside, as the
# gateway container sees them. Empty disables the containment check.
# TOOL_GUARD_WORKSPACE_ROOTS=/home/node/.openclaw/workspace,/tmp

# Tools capable of side effects (exec / write / egress / channel actions).
# Sensitive calls are escalated to AI Defense; benign reads short-circuit
# locally so the guard adds no latency to them.
# TOOL_GUARD_SENSITIVE_TOOLS=exec,bash,process,write,edit,apply_patch,web_fetch,browser,message,canvas,nodes,cron,gateway,sessions_spawn

# Egress allowlist for URLs found in tool arguments (host or host:port).
# Empty = deny-by-default: every egress host is unapproved.
# TOOL_GUARD_EGRESS_ALLOW_HOSTS=

# Submit rendered sensitive/suspicious calls to Cisco AI Defense when the
# inspection client is configured. Errors honor AI_DEFENSE_FAIL_OPEN above —
# deliberately no second flag.
# TOOL_GUARD_AI_DEFENSE=True

# Bound on the rendered tool-call text stored in governance events and sent to
# AI Defense. The policy checks themselves read the UNtruncated arguments, and a
# call too large to render fully is force-escalated to AI Defense.
# TOOL_GUARD_MAX_ARG_CHARS=4000

# -----------------------------------------------------------------------------
# NemoClaw Guardrails — the "NemoClaw Guardrails" drawer toggle
# -----------------------------------------------------------------------------
# NVIDIA NemoClaw governs an OpenClaw agent with an OpenShell sandbox policy.
# DemoBot evaluates its copy of that policy (guardrails/nemoclaw/policy.yaml:
# deny-by-default egress, filesystem scopes, denied binaries, local-only
# inference) on every tool call the gateway submits to /api/toolguard/inspect,
# and ingests the real sandbox's OCSF denials when the NemoClaw runtime is up
# (run-nemoclaw.sh). Unlike TOOL_GUARD_ENABLED this toggle IS the enforcement
# switch; the drawer persists it, so this only seeds the default.
# NEMOCLAW_GUARDRAILS_ENABLED=False
# NEMOCLAW_POLICY_PATH=guardrails/nemoclaw/policy.yaml
# Also run a NeMo Guardrails input rail over sensitive tool calls (needs
# NEMO_GUARDRAILS_ENABLED=True; otherwise silently skipped).
# NEMOCLAW_USE_NEMO_RAILS=True
# The NemoClaw RUNTIME (run-nemoclaw.sh / ec2-bootstrap.sh --with-nemoclaw):
# the sandboxed agent's own inference provider is NemoClaw's — NVIDIA endpoints
# need an nvapi- key here (this is NOT DemoBot's provider, which stays local).
# NVIDIA_INFERENCE_API_KEY=
