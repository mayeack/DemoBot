.pytest_cache/
.coverage
htmlcov/

# Distribution
*.tar.gz
*.whl

# Workshop GTM collateral (kept local, not pushed)
collateral/

# Per-replica workshop access keys (generated by deploy/ec2/gen-access-keys.sh)
deploy/ec2/access-keys.env

# Model-scanning demo artifacts: binary pickles, one deliberately tampered.
# Regenerable demo inputs — keep them out of git so a broad `git add` can't
# commit an artifact that trips AV / supply-chain scanners on clone or in CI.
models/scan_demo/
